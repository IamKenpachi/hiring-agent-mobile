# FastAPI Backend Base URL
# Use http://localhost:8001 for Web/iOS Simulator, or http://10.0.2.2:8001 for Android Emulator,
# or your LAN IP (e.g. http://192.168.1.50:8001) when running on a physical device with Expo Go.
EXPO_PUBLIC_API_URL=http://localhost:8001

# Supabase Project Auth Configuration (optional, needed for Google OAuth)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional Sentry DSN for mobile error tracking
EXPO_PUBLIC_SENTRY_DSN=

