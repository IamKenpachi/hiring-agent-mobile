# FastAPI Backend Base URL
# Production (EAS Build / Store Release): point to your deployed HTTPS Railway backend.
# Local Development overrides (in .env):
#   - Web / iOS Simulator: http://localhost:8001
#   - Android Emulator:    http://10.0.2.2:8001
#   - Physical Device:     http://<your-lan-ip>:8001
EXPO_PUBLIC_API_URL=https://your-backend.up.railway.app

# Supabase Project Auth Configuration (needed for Email/Password + Google OAuth)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional Sentry DSN for mobile crash and performance monitoring
EXPO_PUBLIC_SENTRY_DSN=
