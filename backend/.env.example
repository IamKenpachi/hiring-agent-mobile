# Backend Environment Configuration
ENVIRONMENT=development
PORT=8001

# Database (defaults to local SQLite; use Supabase Supavisor transaction pooler port 6543 in production)
DATABASE_URL=sqlite:///./data/hiring_mobile.db

# Authentication (in production, JWT_SECRET must be >=16 chars and non-default)
JWT_SECRET=change-me-to-a-long-random-secret
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SECRET=
EMAIL_CONFIRM_AUTO=false

# Google Gemini (server fallback enables Starter Trial / Reviewer Mode; BYOK mobile clients pass X-Gemini-Api-Key)
GEMINI_API_KEY=
DEFAULT_MODEL=gemini-3.8-flash
DEMO_TRIAL_MAX_CALLS_PER_USER=15

# JobSpy Datacenter Scraping Resilience (optional proxy URL or comma-separated proxy list)
JOBSPY_PROXY_URL=

# Public Compliance & Branding
PUBLIC_APP_NAME=Hiring Agent
SUPPORT_EMAIL=support@hiringagent.app

# Observability
SENTRY_DSN=

# CORS & Host Security (set explicit comma-separated origins/hosts in production; "*" forbidden for CORS_ORIGINS in prod)
CORS_ORIGINS=*
ALLOWED_HOSTS=*
