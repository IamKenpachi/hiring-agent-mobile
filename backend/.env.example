# Backend Environment Configuration
ENVIRONMENT=development
PORT=8001

# Database (defaults to local SQLite if unset)
DATABASE_URL=sqlite:///./data/hiring_mobile.db

# Authentication
JWT_SECRET=change-me-to-a-long-random-secret
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SECRET=

# Google Gemini (optional server fallback; mobile clients supply X-Gemini-Api-Key)
GEMINI_API_KEY=
DEFAULT_MODEL=gemini-3.7-flash

# Observability
SENTRY_DSN=

# CORS
CORS_ORIGINS=*
